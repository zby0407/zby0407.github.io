---
import '@styles/global.css';

import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import { site } from '@config/site';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  robots?: string;
}

const {
  title = site.author.name,
  description = site.description,
  image = site.og.image || undefined,
  noindex = false,
  robots,
} = Astro.props;

const pageTitle = title === site.author.name ? title : `${title} | ${site.author.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url);
const resolvedImage = image?.startsWith('/')
  ? `${import.meta.env.BASE_URL}${image.slice(1)}`
  : image;
const ogImage = resolvedImage ? new URL(resolvedImage, site.url).toString() : undefined;

// Theme color override
const lightColor = site.theme.color.light === 'auto' ? null : site.theme.color.light;
const darkColor = site.theme.color.dark === 'auto' ? null : site.theme.color.dark;
const colorOverrideStyle = [
  lightColor
    ? `:root,[data-theme='light']{--global-theme-color:${lightColor};--global-hover-color:${lightColor};}`
    : '',
  darkColor
    ? `[data-theme='dark']{--global-theme-color:${darkColor};--global-hover-color:${darkColor};}`
    : '',
]
  .filter(Boolean)
  .join('');
---

<!doctype html>
<html lang={site.lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {(robots || noindex) && <meta name="robots" content={robots ?? 'noindex, nofollow'} />}

    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>

    <!-- Favicon -->
    <link rel="icon" href={`${site.base}/favicon.svg`} type="image/svg+xml" />

    <!-- Theme color override -->
    {colorOverrideStyle && <Fragment set:html={`<style>${colorOverrideStyle}</style>`} />}

    <!-- Open Graph -->
    {
      site.og.enabled && (
        <>
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalURL} />
          <meta property="og:type" content="website" />
          {ogImage && <meta property="og:image" content={ogImage} />}
          <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
          <meta name="twitter:title" content={pageTitle} />
          <meta name="twitter:description" content={description} />
          {ogImage && <meta name="twitter:image" content={ogImage} />}
        </>
      )
    }

    <!-- View Transitions -->
    {site.features.viewTransitions && <ClientRouter />}

    <!-- Dark mode -->
    <script is:inline define:vars={{ defaultTheme: site.theme.default }}>
      function applyTheme() {
        const stored = localStorage.getItem('theme');
        let theme;
        if (stored === 'light' || stored === 'dark') {
          theme = stored;
        } else if (defaultTheme === 'system') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        } else {
          theme = defaultTheme;
        }
        document.documentElement.setAttribute('data-theme', theme);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <Navbar />

    <main id="main-content" class="flex-1" data-pagefind-body>
      <slot />
    </main>

    {site.footer.position !== 'hidden' && <Footer />}
  </body>
</html>
