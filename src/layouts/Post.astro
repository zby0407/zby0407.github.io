---
import { site } from '@config/site';
import Base from './Base.astro';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  headings?: MarkdownHeading[];
}

const { post } = Astro.props;
const {
  title, description, date, lastmod, tags = [], categories = [],
  robots, draft = false,
} = post.data;

const effectiveRobots = draft ? 'noindex, nofollow' : robots;

const lastmodFormatted = lastmod
  ? lastmod.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const formatDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).replace(/\//g, '.');
---

<Base title={title} description={description} robots={effectiveRobots}>
  <div class="page-container py-12">
    <article>
      <!-- Header -->
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-4 text-sm" style="color: var(--global-text-color-muted)">
          <time>{formatDate(date)}</time>
          {categories && categories.length > 0 && (
            <>
              <span>·</span>
              <span style="color: var(--global-theme-color)">{categories[0]}</span>
            </>
          )}
        </div>
        <h1 class="text-2xl md:text-3xl font-semibold leading-tight" style="color: var(--global-text-color)">
          {title}
        </h1>
        {description && (
          <p class="mt-4 text-base" style="color: var(--global-text-color-light)">
            {description}
          </p>
        )}
        {lastmodFormatted && (
          <p class="mt-2 text-xs" style="color: var(--global-text-color-muted)">
            更新于 <time datetime={lastmod!.toISOString()}>{lastmodFormatted}</time>
          </p>
        )}
      </header>

      <!-- Body -->
      <div class="prose max-w-none" id="post-content">
        <slot />
      </div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mt-10 pt-6 flex flex-wrap gap-2" style="border-top: 1px solid var(--global-divider-color)">
          {tags.map(tag => (
            <span
              class="text-xs px-2 py-1 rounded"
              style="background: var(--global-card-bg-color); color: var(--global-text-color-light)"
            >
              {tag}
            </span>
          ))}
        </div>
      )}
    </article>
  </div>
</Base>

<!-- Medium zoom for post images -->
<script>
  import mediumZoom from 'medium-zoom';

  function initZoom() {
    const imgs = document.querySelectorAll<HTMLImageElement>('#post-content img:not(.no-zoom)');
    if (imgs.length === 0) return;
    mediumZoom(imgs, { background: 'rgba(0,0,0,0.7)', margin: 24 });
  }

  initZoom();
  document.addEventListener('astro:page-load', initZoom);
</script>
