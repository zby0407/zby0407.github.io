---
import Giscus from '@components/Giscus.astro';
import ReadingProgress from '@components/ReadingProgress.astro';
import TOC from '@components/TOC.astro';
import { site } from '@config/site';
import Base from './Base.astro';
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  headings?: MarkdownHeading[];
  related?: CollectionEntry<'posts'>[];
}

const { post, headings = [], related = [] } = Astro.props;
const {
  title, description, date, lastmod, tags = [], categories = [],
  robots, draft = false,
} = post.data;

const effectiveRobots = draft ? 'noindex, nofollow' : robots;

const lastmodFormatted = lastmod
  ? lastmod.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const formatDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).replace(/\//g, '.');
---

<Base title={title} description={description} robots={effectiveRobots}>
  <ReadingProgress />

  <div class="max-w-4xl mx-auto py-12 px-4 lg:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-[180px_1fr] gap-8 lg:gap-12">
      <!-- TOC sidebar (desktop only) -->
      <aside class="hidden lg:block">
        {headings.length > 0 && <TOC headings={headings} />}
      </aside>

      <article>
        <!-- Header -->
        <header class="mb-10">
          <div class="flex items-center gap-3 mb-4 text-sm" style="color: var(--global-text-color-muted)">
            <time>{formatDate(date)}</time>
            {categories && categories.length > 0 && (
              <>
                <span>·</span>
                <a href={`/categories/${categories[0]}/`} style="color: var(--global-theme-color); text-decoration: none;">
                  {categories[0]}
                </a>
              </>
            )}
          </div>
          <h1 class="text-2xl md:text-3xl font-semibold leading-tight" style="color: var(--global-text-color)">
            {title}
          </h1>
          {description && (
            <p class="mt-4 text-base" style="color: var(--global-text-color-light)">
              {description}
            </p>
          )}
          {lastmodFormatted && (
            <p class="mt-2 text-xs" style="color: var(--global-text-color-muted)">
              更新于 <time datetime={lastmod!.toISOString()}>{lastmodFormatted}</time>
            </p>
          )}
        </header>

        <!-- Body -->
        <div class="prose max-w-none" id="post-content">
          <slot />
        </div>

        <!-- Tags -->
        {tags.length > 0 && (
          <div class="mt-10 pt-6 flex flex-wrap gap-2" style="border-top: 1px solid var(--global-divider-color)">
            {tags.map(tag => (
              <a
                href={`/tags/${tag}/`}
                class="text-xs px-2 py-1 rounded transition-colors"
                style="background: var(--global-card-bg-color); color: var(--global-text-color-light); text-decoration: none;"
              >
                {tag}
              </a>
            ))}
          </div>
        )}

        <!-- Related posts -->
        {related.length > 0 && (
          <div class="mt-12 pt-8" style="border-top: 1px solid var(--global-divider-color)">
            <h2 class="text-sm font-semibold mb-4 tracking-wide uppercase" style="color: var(--global-text-color-light)">
              相关文章
            </h2>
            <div class="space-y-4">
              {related.map(r => (
                <a
                  href={`/blog/${r.id}/`}
                  class="block group"
                  style="text-decoration: none;"
                >
                  <h3 class="text-base font-medium transition-colors" style="color: var(--global-text-color)">
                    <span class="group-hover:underline">{r.data.title}</span>
                  </h3>
                  {r.data.description && (
                    <p class="text-sm mt-1 line-clamp-2" style="color: var(--global-text-color-light)">
                      {r.data.description}
                    </p>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Comments -->
        <Giscus />
      </article>
    </div>
  </div>
</Base>

<!-- Medium zoom for post images -->
<script>
  import mediumZoom from 'medium-zoom';

  function initZoom() {
    const imgs = document.querySelectorAll<HTMLImageElement>('#post-content img:not(.no-zoom)');
    if (imgs.length === 0) return;
    mediumZoom(imgs, { background: 'rgba(0,0,0,0.7)', margin: 24 });
  }

  initZoom();
  document.addEventListener('astro:page-load', initZoom);
</script>
