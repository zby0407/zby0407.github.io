---
import Icon from "@/components/ui/Icon.astro";
import TagPill from "@/components/blog/TagPill.astro";

interface Props {
	tags: string[];
	class?: string;
}

const { tags, class: className } = Astro.props;
---

{
	tags.length > 0 && (
		<aside class={`tag-sidebar print:hidden ${className || ""}`}>
			<div class="tag-sidebar-header mb-2 flex items-center gap-1.5 text-xs font-semibold text-textColor/60">
				<Icon class="h-3.5 w-3.5" name="tag-outline" aria-hidden="true" focusable="false" />
				<span>标签</span>
			</div>
			<div class="flex flex-wrap gap-1.5">
				{tags.map((tag) => (
					<TagPill tag={tag} />
				))}
			</div>
		</aside>
	)
}

<style>
	.tag-sidebar {
		position: fixed;
		right: 1rem;
		bottom: 5rem;
		z-index: 10;
		display: none;
		background-color: color-mix(in srgb, var(--theme-bg) 95%, var(--theme-popover-bg));
		border: 1px solid color-mix(in srgb, var(--theme-accent) 10%, var(--theme-bg));
		border-radius: 0.75rem;
		padding: 0.75rem;
		width: 10rem;
		max-height: 50vh;
		overflow-y: auto;
		box-shadow: 0 4px 6px -1px color-mix(in srgb, var(--theme-accent) 5%, transparent);
	}

	@media (min-width: 640px) {
		.tag-sidebar {
			display: block;
			top: 10rem;
			bottom: auto;
		}
	}

	.tag-sidebar-lower {
		top: 20rem;
	}

	.tag-sidebar-header {
		border-bottom: 1px solid color-mix(in srgb, var(--theme-accent-2) 8%, transparent);
		padding-bottom: 0.25rem;
	}
</style>
