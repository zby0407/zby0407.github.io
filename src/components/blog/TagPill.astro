---
import { getNavLink } from "@/lib/blog-helpers";
import { slugify } from "@/utils/slugify";

interface Props {
	tag: string;
	count?: number;
	class?: string;
	[key: string]: any;
}

const { tag, count, class: className, ...rest } = Astro.props;

// Ultra-soft pastel palette matching the webtrotion screenshot.
// Uses 50-step Tailwind colors for barely-there backgrounds.
const styles = [
	"bg-green-50 text-green-900 dark:bg-green-950/40 dark:text-green-200",
	"bg-orange-50 text-orange-900 dark:bg-orange-950/40 dark:text-orange-200",
	"bg-violet-50 text-violet-900 dark:bg-violet-950/40 dark:text-violet-200",
	"bg-rose-50 text-rose-900 dark:bg-rose-950/40 dark:text-rose-200",
	"bg-sky-50 text-sky-900 dark:bg-sky-950/40 dark:text-sky-200",
	"bg-teal-50 text-teal-900 dark:bg-teal-950/40 dark:text-teal-200",
	"bg-amber-50 text-amber-900 dark:bg-amber-950/40 dark:text-amber-200",
	"bg-indigo-50 text-indigo-900 dark:bg-indigo-950/40 dark:text-indigo-200",
	"bg-fuchsia-50 text-fuchsia-900 dark:bg-fuchsia-950/40 dark:text-fuchsia-200",
	"bg-cyan-50 text-cyan-900 dark:bg-cyan-950/40 dark:text-cyan-200",
	"bg-stone-100 text-stone-800 dark:bg-stone-900/40 dark:text-stone-200",
	"bg-pink-50 text-pink-900 dark:bg-pink-950/40 dark:text-pink-200",
];

const index = tag.split("").reduce((a, c) => a + c.charCodeAt(0), 0) % styles.length;
const style = styles[index];
---

<a
	class={`inline-flex items-center rounded-lg px-3 py-1 text-sm transition hover:opacity-80 ${style} ${className || ""}`}
	href={getNavLink("/tags/" + slugify(tag) + "/")}
	aria-label={`查看标签 ${tag} 的文章`}
	data-pagefind-filter="tags"
	{...rest}
>
	{tag}
	{count !== undefined && (
		<span class="ms-1.5 inline-flex h-5 min-w-[1.25rem] items-center justify-center rounded bg-white px-1 text-xs font-semibold tabular-nums text-current shadow-sm dark:bg-black/30">
			{count}
		</span>
	)}
</a>
