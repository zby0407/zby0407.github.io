---
// Search trigger button + modal overlay. Uses Pagefind JS API.
---

<button
  id="search-trigger"
  aria-label="搜索"
  title="搜索 (Cmd/Ctrl + K)"
  style="padding: 0; border: 0; background-color: inherit; color: var(--global-text-color); width: 2rem; height: 2rem; display: inline-flex; align-items: center; justify-content: center; cursor: pointer;"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
</button>

<div
  id="search-overlay"
  class="fixed inset-0 z-50 hidden"
  style="padding: 1rem;"
>
  <!-- Backdrop -->
  <div
    id="search-backdrop"
    class="absolute inset-0"
    style="background: rgba(0,0,0,0.4); backdrop-filter: blur(2px);"
  ></div>

  <!-- Modal -->
  <div
    class="relative mx-auto w-full"
    style="max-width: 520px; margin-top: 12vh;"
  >
    <div
      class="rounded-lg shadow-xl overflow-hidden"
      style="background: var(--global-card-bg-color); border: 1px solid var(--global-divider-color);"
    >
      <!-- Input -->
      <div class="flex items-center px-4 py-3" style="border-bottom: 1px solid var(--global-divider-color);">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          style="color: var(--global-text-color-muted); flex-shrink: 0;"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="搜索文章..."
          autocomplete="off"
          class="flex-1 ml-3 bg-transparent border-0 outline-none"
          style="color: var(--global-text-color); font-size: 0.95rem;"
        />
        <kbd
          class="hidden sm:inline-block text-xs px-1.5 py-0.5 rounded"
          style="background: var(--global-bg-color); color: var(--global-text-color-muted); border: 1px solid var(--global-divider-color); font-family: var(--font-sans);"
        >ESC</kbd>
      </div>

      <!-- Results -->
      <div
        id="search-results"
        class="px-4 py-2"
        style="max-height: 360px; overflow-y: auto;"
      ></div>

      <!-- Footer -->
      <div
        class="px-4 py-2 text-xs flex justify-between"
        style="border-top: 1px solid var(--global-divider-color); color: var(--global-text-color-muted);"
      >
        <span id="search-status"></span>
        <span>Pagefind</span>
      </div>
    </div>
  </div>
</div>

<script>
  const trigger = document.getElementById('search-trigger');
  const overlay = document.getElementById('search-overlay');
  const backdrop = document.getElementById('search-backdrop');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search-results');
  const statusEl = document.getElementById('search-status');

  let pagefind: any = null;
  let pagefindReady = false;

  async function initPagefind() {
    if (pagefindReady) return true;
    try {
      // @ts-ignore
      pagefind = await import(/* @vite-ignore */ '/pagefind/pagefind.js');
      pagefindReady = true;
      return true;
    } catch {
      return false;
    }
  }

  function openModal() {
    overlay?.classList.remove('hidden');
    input?.focus();
    initPagefind().then((ok) => {
      if (!ok && statusEl) {
        statusEl.textContent = '搜索索引仅在构建后可用';
      }
    });
  }

  function closeModal() {
    overlay?.classList.add('hidden');
    if (input) input.value = '';
    if (resultsEl) resultsEl.innerHTML = '';
    if (statusEl) statusEl.textContent = '';
  }

  trigger?.addEventListener('click', openModal);
  backdrop?.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      openModal();
    }
    if (e.key === 'Escape' && !overlay?.classList.contains('hidden')) {
      closeModal();
    }
  });

  document.addEventListener('astro:after-swap', closeModal);

  input?.addEventListener('input', async (e) => {
    const query = (e.target as HTMLInputElement).value.trim();
    if (!resultsEl || !statusEl) return;

    if (!query) {
      resultsEl.innerHTML = '';
      statusEl.textContent = '';
      return;
    }

    const ok = await initPagefind();
    if (!ok) {
      resultsEl.innerHTML = '<p class="text-sm py-4 text-center" style="color: var(--global-text-color-muted);">搜索索引未生成，请先构建站点。</p>';
      return;
    }

    const search = await pagefind.search(query);
    statusEl.textContent = `找到 ${search.results.length} 条结果`;

    if (search.results.length === 0) {
      resultsEl.innerHTML = '<p class="text-sm py-4 text-center" style="color: var(--global-text-color-muted);">未找到相关文章</p>';
      return;
    }

    const items = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));

    resultsEl.innerHTML = items
      .map(
        (item: any) => `
          <a
            href="${item.url}"
            class="block py-2 px-2 rounded transition-colors"
            style="text-decoration: none; color: inherit;"
            onmouseover="this.style.background='var(--global-bg-color)'"
            onmouseout="this.style.background='transparent'"
          >
            <div class="text-sm font-medium" style="color: var(--global-theme-color);">${item.meta.title || '无标题'}</div>
            <div class="text-xs mt-0.5 line-clamp-2" style="color: var(--global-text-color-light);">${item.excerpt || ''}</div>
          </a>
        `
      )
      .join('');
  });
</script>
