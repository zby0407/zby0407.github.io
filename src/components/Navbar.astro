---
import type { NavDropdown, NavItem, NavLeaf } from '@config/site';
import { site } from '@config/site';

import ThemeToggle from './ThemeToggle.astro';

function isLeaf(item: NavItem): item is NavLeaf {
  return 'href' in item;
}
function isDropdown(item: NavItem): item is NavDropdown {
  return 'children' in item;
}

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  const full = `${site.base}${href}`;
  if (href === '/') return pathname === full || pathname === site.base;
  return pathname.startsWith(full);
}

function hasActiveChild(item: NavDropdown): boolean {
  return item.children.some((c) => isActive(c.href));
}

const items = site.navbar.items;
---

<nav class="w-full py-6">
  <div class="page-container flex items-center justify-between">
    <a
      href={`${site.base}/`}
      class="text-lg font-medium tracking-wide"
      style="color: var(--global-text-color); text-decoration: none;"
    >
      {site.title}
    </a>

    <div class="flex items-center gap-6">
      {
        items.map((item) => {
          if (isLeaf(item)) {
            const active = isActive(item.href);
            return (
              <a
                href={`${site.base}${item.href}`}
                class="text-sm transition-colors duration-200"
                style={`color: ${active ? 'var(--global-theme-color)' : 'var(--global-text-color-light)'}; text-decoration: none;`}
              >
                {item.label}
              </a>
            );
          }

          if (isDropdown(item)) {
            const active = hasActiveChild(item);
            return (
              <div class="relative group">
                <button
                  class="text-sm"
                  style={`color: ${active ? 'var(--global-theme-color)' : 'var(--global-text-color-light)'}; background: none; border: none; cursor: pointer;`}
                >
                  {item.label}
                </button>
                <ul class="absolute top-full right-0 mt-1 hidden group-hover:block bg-white dark:bg-gray-800 border rounded shadow-lg py-1 min-w-[120px]">
                  {item.children.map((child) => {
                    const childActive = isActive(child.href);
                    return (
                      <li>
                        <a
                          href={`${site.base}${child.href}`}
                          class="block px-4 py-2 text-sm"
                          style={`color: ${childActive ? 'var(--global-theme-color)' : 'var(--global-text-color)'}; text-decoration: none;`}
                        >
                          {child.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            );
          }
        })
      }

      <ThemeToggle />
    </div>
  </div>
</nav>
