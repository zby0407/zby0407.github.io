---
interface Props {
  title: string;
  open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="toggle-block my-4 rounded-lg border border-accent/10 bg-accent/5 px-4 py-3" {...(open ? { open: true } : {})}>
  <summary class="cursor-pointer list-none font-semibold text-textColor transition hover:text-accent">
    <span class="mr-2 inline-block transition-transform duration-200" data-toggle-icon>{open ? "▼" : "▶"}</span>
    {title}
  </summary>
  <div class="toggle-content mt-3 text-sm leading-relaxed">
    <slot />
  </div>
</details>

<script>
  document.querySelectorAll("details.toggle-block").forEach((detail) => {
    const icon = detail.querySelector("[data-toggle-icon]");
    detail.addEventListener("toggle", () => {
      if (icon) {
        icon.textContent = detail.open ? "▼" : "▶";
      }
    });
  });
</script>

<style>
  details.toggle-block > summary::-webkit-details-marker {
    display: none;
  }
</style>