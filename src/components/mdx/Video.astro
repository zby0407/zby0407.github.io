---
interface Props {
	src: string;
	caption?: string;
	poster?: string;
}

const { src, caption, poster } = Astro.props;
---

<figure class="my-4">
	<video class="w-full rounded-lg" controls preload="metadata" poster={poster}>
		<source src={src} />
		Your browser does not support the video element.
	</video>
	{caption && <figcaption class="mt-1 text-center text-xs text-textColor/60">{caption}</figcaption>}
</figure>
