---
import { site } from '@config/site';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="w-full py-8 mt-auto" style="border-top: 1px solid var(--global-divider-color)">
  <div class="page-container">
    <div class="flex flex-col items-center gap-3">
      <SocialLinks size={16} />
      <p class="text-sm" style="color: var(--global-text-color-muted)">
        &copy; {year} {site.author.name}
      </p>
    </div>
  </div>
</footer>
