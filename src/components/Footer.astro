---
import { site } from '@config/site';

const year = new Date().getFullYear();
---

<footer class="w-full py-8 mt-auto" style="border-top: 1px solid var(--global-divider-color)">
  <div class="page-container text-center">
    <p class="text-sm" style="color: var(--global-text-color-muted)">
      &copy; {year} {site.author.name}
    </p>
  </div>
</footer>
