---
import PageLayout from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import { getNavLink } from "@/lib/blog-helpers";

const projects = (await getCollection("projects"))
  .sort((a, b) => (a.data.importance || 999) - (b.data.importance || 999));

const parseMdLink = (text: string) =>
  text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener noreferrer" class="site-page-link">$1</a>'
  );
---

<PageLayout
  meta={{
    title: "项目",
    description: "我的项目作品",
  }}
>
  <div class="max-w-[708px] sm:mr-20">
    <h1 class="title mb-8">项目</h1>
    <ul class="space-y-6">
      {
        projects.map((project) => (
          <li class="flex max-w-full flex-col flex-wrap gap-1.5">
            <a
              href={project.data.url || getNavLink(`/projects/${project.id}/`)}
              class="site-page-link text-lg font-semibold"
            >
              {project.data.title}
            </a>
            {project.data.description && (
              <p class="text-sm text-textColor/70" set:html={parseMdLink(project.data.description)} />
            )}
            {project.data.category && (
              <span class="text-xs text-textColor/50">{project.data.category}</span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</PageLayout>
