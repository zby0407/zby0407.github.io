---
import { site } from '@config/site';
import Base from '@layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((p) => !p.data.hidden && !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

// Anime images for the gallery lightbox.
// Replace these with your own images placed in public/assets/anime/
const galleryImages = [
  { src: 'https://picsum.photos/seed/anime1/800/1000', alt: '', thumb: 'https://picsum.photos/seed/anime1/400/500' },
  { src: 'https://picsum.photos/seed/anime2/800/1000', alt: '', thumb: 'https://picsum.photos/seed/anime2/400/500' },
  { src: 'https://picsum.photos/seed/anime3/800/1000', alt: '', thumb: 'https://picsum.photos/seed/anime3/400/500' },
  { src: 'https://picsum.photos/seed/anime4/800/1000', alt: '', thumb: 'https://picsum.photos/seed/anime4/400/500' },
  { src: 'https://picsum.photos/seed/anime5/800/1000', alt: '', thumb: 'https://picsum.photos/seed/anime5/400/500' },
];

const formatDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).replace(/\//g, '.');
---

<Base>
  <div class="relative">
    <!-- Hero Section -->
    <section class="min-h-screen flex flex-col items-center justify-center px-6 relative">
      <!-- Logo mark -->
      <div class="text-center mb-12">
        <div
          class="text-5xl md:text-7xl font-light mb-3 tracking-wide"
          style="color: var(--global-text-color); font-family: 'Noto Serif SC', serif;"
        >
          赫萝的羊皮纸
        </div>
        <div class="text-xs tracking-[0.4em] uppercase" style="color: var(--global-text-color-muted);">
          Horo's Parchment
        </div>
      </div>

      <!-- Anime gallery grid -->
      <div class="w-full max-w-4xl mx-auto">
        <div class="gallery-grid">
          {
            galleryImages.map((img, i) => (
              <button
                class="gallery-thumb group relative overflow-hidden rounded-sm"
                data-index={i}
                aria-label={`查看图片 ${i + 1}`}
              >
                <img
                  src={img.thumb}
                  alt={img.alt}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: rgba(0,0,0,0.2);">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                </div>
              </button>
            ))
          }
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
        <span class="text-xs tracking-widest" style="color: var(--global-text-color-muted);">SCROLL</span>
        <div class="w-px h-8 animate-pulse" style="background: var(--global-text-color-muted);">
        </div>
      </div>
    </section>

    <!-- Lightbox -->
    <div id="lightbox" class="fixed inset-0 z-[100] hidden" style="background: rgba(0,0,0,0.92);">
      <!-- Close button -->
      <button id="lightbox-close" class="absolute top-4 right-4 z-10 w-10 h-10 flex items-center justify-center rounded-full" style="background: rgba(255,255,255,0.1); color: #fff;" aria-label="关闭">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <!-- Counter -->
      <div id="lightbox-counter" class="absolute top-4 left-1/2 -translate-x-1/2 text-sm" style="color: rgba(255,255,255,0.7);"></div>

      <!-- Main image -->
      <div class="absolute inset-0 flex items-center justify-center px-16 py-12">
        <img id="lightbox-img" src="" alt="" class="max-w-full max-h-full object-contain transition-opacity duration-300" />
      </div>

      <!-- Prev/Next arrows -->
      <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full" style="background: rgba(255,255,255,0.1); color: #fff;" aria-label="上一张">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 flex items-center justify-center rounded-full" style="background: rgba(255,255,255,0.1); color: #fff;" aria-label="下一张">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <!-- Latest posts section -->
    <section class="py-24 px-6" style="border-top: 1px solid var(--global-divider-color);">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-baseline justify-between mb-12">
          <h2 class="text-sm tracking-[0.2em] uppercase font-medium" style="color: var(--global-text-color);">
            Latest
          </h2>
          <a
            href="/blog/"
            class="text-xs tracking-wider transition-colors hover:opacity-70"
            style="color: var(--global-theme-color); text-decoration: none;"
          >
            VIEW ALL →
          </a>
        </div>

        <div class="space-y-0">
          {
            posts.map((post, i) => (
              <a
                href={`/blog/${post.id}/`}
                class="group block py-8 transition-colors"
                style={i !== posts.length - 1 ? 'border-bottom: 1px solid var(--global-divider-color);' : ''}
              >
                <div class="flex items-start gap-6 md:gap-10">
                  <time
                    class="text-xs tabular-nums shrink-0 mt-1 w-16"
                    style="color: var(--global-text-color-muted);"
                  >
                    {formatDate(post.data.date)}
                  </time>
                  <div class="flex-1 min-w-0">
                    <h3
                      class="text-base md:text-lg font-medium mb-2 transition-colors group-hover:text-[var(--global-theme-color)]"
                      style="color: var(--global-text-color);"
                    >
                      {post.data.title}
                    </h3>
                    {post.data.description && (
                      <p class="text-sm line-clamp-2" style="color: var(--global-text-color-light);">
                        {post.data.description}
                      </p>
                    )}
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="flex gap-2 mt-3">
                        {post.data.tags.slice(0, 3).map((tag) => (
                          <span class="text-xs" style="color: var(--global-text-color-muted);">
                            {tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                  {post.data.image && (
                    <div class="hidden md:block shrink-0 w-24 h-16 overflow-hidden rounded-sm">
                      <img
                        src={post.data.image}
                        alt=""
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                      />
                    </div>
                  )}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <script is:inline data-astro-rerun>
    (function() {
      // --- Gallery Lightbox ---
      const images = [
        { src: 'https://picsum.photos/seed/anime1/800/1000' },
        { src: 'https://picsum.photos/seed/anime2/800/1000' },
        { src: 'https://picsum.photos/seed/anime3/800/1000' },
        { src: 'https://picsum.photos/seed/anime4/800/1000' },
        { src: 'https://picsum.photos/seed/anime5/800/1000' },
      ];

      const thumbs = document.querySelectorAll('.gallery-thumb');
      const lightbox = document.getElementById('lightbox');
      const lightboxImg = document.getElementById('lightbox-img');
      const lightboxCounter = document.getElementById('lightbox-counter');
      const closeBtn = document.getElementById('lightbox-close');
      const prevBtn = document.getElementById('lightbox-prev');
      const nextBtn = document.getElementById('lightbox-next');

      let current = 0;

      function open(index) {
        current = index;
        updateImage();
        lightbox.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      }

      function updateImage() {
        lightboxImg.style.opacity = '0';
        setTimeout(() => {
          lightboxImg.src = images[current].src;
          lightboxImg.onload = () => { lightboxImg.style.opacity = '1'; };
          lightboxCounter.textContent = (current + 1) + ' / ' + images.length;
        }, 150);
      }

      function next() {
        current = (current + 1) % images.length;
        updateImage();
      }

      function prev() {
        current = (current - 1 + images.length) % images.length;
        updateImage();
      }

      thumbs.forEach((thumb, i) => {
        thumb.addEventListener('click', () => open(i));
      });

      closeBtn?.addEventListener('click', close);
      nextBtn?.addEventListener('click', next);
      prevBtn?.addEventListener('click', prev);

      lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });

      document.addEventListener('keydown', (e) => {
        if (lightbox?.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowRight') next();
        if (e.key === 'ArrowLeft') prev();
      });
    })();
  </script>

  <style>
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }

    .gallery-grid .gallery-thumb:nth-child(1) {
      grid-column: 1 / 2;
      grid-row: 1 / 3;
      aspect-ratio: 3/4;
    }

    .gallery-grid .gallery-thumb:nth-child(2) {
      grid-column: 2 / 3;
      grid-row: 1 / 2;
      aspect-ratio: 4/3;
    }

    .gallery-grid .gallery-thumb:nth-child(3) {
      grid-column: 3 / 4;
      grid-row: 1 / 2;
      aspect-ratio: 4/3;
    }

    .gallery-grid .gallery-thumb:nth-child(4) {
      grid-column: 2 / 3;
      grid-row: 2 / 3;
      aspect-ratio: 4/3;
    }

    .gallery-grid .gallery-thumb:nth-child(5) {
      grid-column: 3 / 4;
      grid-row: 2 / 3;
      aspect-ratio: 4/3;
    }

    .gallery-thumb {
      border: none;
      padding: 0;
      cursor: pointer;
      background: none;
    }

    @media (max-width: 768px) {
      .gallery-grid {
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: auto;
      }

      .gallery-grid .gallery-thumb {
        grid-column: auto !important;
        grid-row: auto !important;
        aspect-ratio: 4/3;
      }

      .gallery-grid .gallery-thumb:nth-child(1) {
        grid-column: 1 / 3 !important;
        aspect-ratio: 16/9;
      }
    }
  </style>
</Base>
