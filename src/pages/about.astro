---
import Page from '@layouts/Page.astro';
---

<Page title="关于">
  <div class="py-8 text-center">
    <!-- Avatar -->
    <div class="mb-6">
      <img
        src="/assets/img/prof_pic.jpg"
        alt="头像"
        class="w-20 h-20 rounded-full mx-auto object-cover"
        style="border: 2px solid var(--global-divider-color)"
      />
    </div>

    <!-- Name -->
    <h1 class="text-xl font-semibold mb-2" style="color: var(--global-text-color)">
      你的名字
    </h1>
    <p class="text-sm mb-8" style="color: var(--global-text-color-muted)">
      开发者 / 摄影爱好者 / 生活记录者
    </p>

    <!-- Bio -->
    <div class="text-left text-sm leading-relaxed space-y-4 max-w-md mx-auto" style="color: var(--global-text-color-light)">
      <p>
        这里是关于你的简短介绍。可以写你的职业背景、兴趣爱好、这个博客的缘起等。
      </p>
      <p>
        保持简洁真诚，像给朋友介绍自己一样。
      </p>
    </div>

    <!-- Contact -->
    <div class="mt-10 pt-6" style="border-top: 1px solid var(--global-divider-color)">
      <p class="text-xs mb-3" style="color: var(--global-text-color-muted)">联系方式</p>
      <div class="flex justify-center gap-4 text-sm">
        <a href="https://github.com/yourusername" target="_blank" rel="noopener" class="hover:underline">
          GitHub
        </a>
        <a href="mailto:your@email.com" class="hover:underline">
          邮箱
        </a>
      </div>
    </div>
  </div>
</Page>
